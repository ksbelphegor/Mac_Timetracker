<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jsk.mactimetracker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>/Users/JSK/Programing/Mac_Timetracker/Mac Time Tracker.app</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- 크래시(비정상 종료) 시에만 자동 재시작 — 사용자가 명시적으로 quit하면 떠남 -->
        <key>SuccessfulExit</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/JSK/.mactimetracker/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/JSK/.mactimetracker/launchd-err.log</string>
</dict>
</plist>
